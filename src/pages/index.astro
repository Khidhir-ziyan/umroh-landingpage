---
import '../../src/styles/global.css';

const whatsapp = 'https://wa.me/6287777995846';
const whatsappMessage = `${whatsapp}?text=Assalamu%E2%80%99alaikum%2C%20saya%20ingin%20mulai%20persiapan%20umroh%20mandiri.%20Mohon%20info%20ebooknya.`;
const chapters = [
  ['01', 'Umroh Mandiri: Panggilan yang Bisa Kamu Jawab Sendiri', 'Memahami makna umroh mandiri, kesiapan diri, dan keberanian untuk memulai langkah pertama.'],
  ['02', 'Menyusun Rencana & Waktu', 'Menentukan waktu, durasi, budget, dan gaya perjalanan yang sesuai kondisi Anda.'],
  ['03', 'Dokumen: Fondasi Ketenanganmu', 'Menyiapkan paspor, dokumen wajib, dan administrasi penting secara teratur.'],
  ['04', 'Visa Umroh Mandiri', 'Memahami pilihan visa dan langkah yang perlu diverifikasi sebelum mengajukan.'],
  ['05', 'Tiket Pesawat yang Hemat', 'Memilih waktu, rute, dan penerbangan dengan pertimbangan biaya dan kenyamanan.'],
  ['06', 'Hotel & Penginapan', 'Menimbang lokasi, akses, fasilitas, dan kebutuhan menginap di Makkah & Madinah.'],
  ['07', 'Transportasi & Konektivitas', 'Mengatur transportasi, internet, aplikasi, uang, dan komunikasi sehari-hari.'],
  ['08', 'Bekal Hati & Adab', 'Menyiapkan fisik, mental, niat, adab, dan bekal ibadah sebelum berangkat.'],
  ['09', 'Ihram, Miqat & Niat', 'Memahami persiapan ihram, miqat, dan niat agar lebih siap menjalani rangkaian ibadah.'],
  ['10', 'Tawaf, Sa’i & Tahallul', 'Memahami alur ibadah utama dengan panduan yang ringkas dan mudah diikuti.'],
  ['11', 'Di Tanah Suci: Hari-Harimu', 'Menyusun ritme harian, waktu ibadah, istirahat, dan eksplorasi dengan lebih realistis.'],
  ['12', 'Kepulangan & Setelahnya', 'Menyiapkan proses pulang, barang bawaan, dan langkah setelah kembali ke rumah.'],
  ['13', 'Kit Tempur Umroh Mandiri', 'Checklist, template, dan kontak penting untuk membantu Anda tetap siap di setiap tahap.'],
];
const faqs = [
  ['Apakah umroh mandiri aman untuk pemula?', 'Umroh mandiri membutuhkan persiapan dan keputusan yang lebih aktif. Ebook ini membantu Anda memahami proses, tetapi tetap penting memverifikasi informasi terbaru dan menyesuaikannya dengan kondisi perjalanan Anda.'],
  ['Apakah ebook menjamin biaya pasti lebih murah?', 'Tidak ada angka yang berlaku untuk semua orang. Biaya dipengaruhi musim, tiket, hotel, kurs, dan pilihan layanan. Ebook membantu Anda melihat komponen biaya agar dapat membuat perhitungan yang realistis.'],
  ['Bagaimana jika saya tidak bisa bahasa Arab?', 'Ebook membahas persiapan komunikasi, aplikasi, dan hal praktis yang dapat membantu jamaah tetap lebih percaya diri meski tidak fasih berbahasa Arab.'],
  ['Apakah panduan ini cocok untuk perjalanan bersama keluarga?', 'Ya. Bagian persiapan dan checklist dapat digunakan sebagai dasar untuk menyesuaikan kebutuhan pasangan, anak, orang tua, atau anggota keluarga lain.'],
  ['Bagaimana cara mendapatkan ebook setelah pembayaran?', 'Klik tombol paket yang dipilih untuk menghubungi WhatsApp. Anda akan menerima detail pembayaran, lalu file dikirim setelah pembayaran diverifikasi.'],
];
---
<html lang="id">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <meta name="description" content="Umroh Mandiri dari Nol — panduan praktis dari pengurusan dokumen hingga kembali ke rumah." />
    <link rel="canonical" href="https://umrohsendiri.biz.id/" />
    <meta property="og:title" content="Umroh Mandiri dari Nol — Panduan Praktis" /><meta property="og:type" content="website" /><meta property="og:url" content="https://umrohsendiri.biz.id/" /><meta property="og:image" content="https://umrohsendiri.biz.id/images/cover-ebook.png" />
    <title>Umroh Mandiri dari Nol — Panduan Praktis</title>
  </head>
  <body>
    <header class="sticky top-0 z-20 border-b border-line/80 bg-paper/90 backdrop-blur-xl">
      <div class="mx-auto flex h-[76px] w-[min(1140px,calc(100%-40px))] items-center justify-between gap-7 max-md:w-[calc(100%-28px)] max-md:h-[66px]">
        <a href="#top" class="serif flex items-center gap-3 text-[1.05rem] font-semibold"><span class="grid h-8 w-8 place-items-center rounded-full border border-gold text-gold-deep">✦</span> Umroh Mandiri</a>
        <button id="menu-toggle" class="hidden border-0 bg-transparent p-2 text-xl max-md:block" aria-expanded="false" aria-controls="nav-links" aria-label="Buka menu navigasi">☰</button>
        <nav id="nav-links" class="flex items-center gap-6 text-sm text-muted max-md:absolute max-md:left-3.5 max-md:right-3.5 max-md:top-[66px] max-md:hidden max-md:flex-col max-md:items-stretch max-md:gap-0 max-md:border max-md:border-line max-md:bg-paper max-md:p-4 max-md:shadow-editorial" aria-label="Navigasi utama">
          <a class="py-2 hover:text-ink" href="#isi">Isi ebook</a><a class="py-2 hover:text-ink" href="#paket">Paket</a><a class="py-2 hover:text-ink" href="#penulis">Penulis</a><a class="py-2 hover:text-ink" href="#faq">FAQ</a>
          <a class="rounded-full border border-gold px-4 py-2 text-xs font-bold text-gold-deep max-md:mt-1 max-md:text-center" href={whatsappMessage} target="_blank" rel="noopener">Chat WhatsApp ↗</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="relative overflow-hidden px-0 py-24 max-md:py-16"><div class="pointer-events-none absolute right-[-190px] top-24 h-[510px] w-[510px] rounded-full border border-gold-soft hero-ring"></div><div class="relative z-10 mx-auto grid w-[min(1140px,calc(100%-40px))] grid-cols-[1.05fr_.95fr] items-center gap-[70px] max-[900px]:grid-cols-1 max-[900px]:gap-14 max-md:w-[calc(100%-28px)]">
        <div class="reveal max-w-[680px]"><span class="inline-flex items-center gap-2.5 text-[.72rem] font-bold uppercase tracking-[.16em] text-gold-deep before:h-px before:w-7 before:bg-current">Panduan perjalanan yang lebih tenang</span><h1 class="serif my-6 text-[clamp(3.1rem,7vw,6.4rem)] font-semibold leading-[1.12] tracking-[-.065em] max-md:text-[clamp(2.85rem,14vw,5rem)]">Umroh mandiri,<br /><em class="not-italic text-gold-deep">dari nol.</em></h1><p class="max-w-[555px] text-[1.1rem] text-muted max-md:text-base">Panduan praktis untuk merencanakan umroh mandiri dengan langkah yang jelas — dari pengurusan dokumen sampai kembali ke rumah.</p><div class="mt-8 flex flex-wrap gap-3.5"><a class="rounded-full bg-gold px-6 py-4 text-center text-sm font-bold text-white shadow-lg shadow-gold/20 transition hover:-translate-y-0.5 hover:bg-gold-deep" href={whatsappMessage} target="_blank" rel="noopener">Mulai persiapan lewat WhatsApp ↗</a><a class="rounded-full border border-line bg-white/50 px-6 py-4 text-center text-sm font-bold transition hover:-translate-y-0.5 hover:border-gold" href="#isi">Lihat isi ebook</a></div><div class="mt-6 flex items-center gap-3 text-xs text-muted"><span class="grid h-6 w-6 place-items-center rounded-full bg-gold-soft text-gold-deep">✓</span> Disusun dari pengalaman umroh mandiri, untuk jamaah pemula.</div></div>
        <div class="reveal relative grid min-h-[480px] place-items-center max-md:min-h-[430px]"><div class="absolute bottom-9 h-11 w-[310px] rounded-[50%] bg-ink/20 blur-xl"></div><div class="book-page relative h-[410px] w-[295px] rotate-[5deg] overflow-hidden rounded-[5px_14px_14px_5px] bg-gradient-to-br from-[#f8f1df] to-[#d9bf80] p-[38px_30px] text-green max-md:h-[355px] max-md:w-[255px] max-md:p-[29px_25px]"><div class="relative z-10 text-[.62rem] uppercase tracking-[.2em] text-gold-deep">Panduan praktis · edisi pertama</div><h2 class="serif relative z-10 mt-16 text-[2.36rem] font-semibold leading-none max-md:mt-12 max-md:text-[2rem]">Umroh<br />Mandiri<br />dari Nol</h2><p class="relative z-10 mt-4 max-w-40 text-xs text-green/80">13 bab untuk membuat perjalanan ibadah terasa lebih siap dan terarah.</p><div class="absolute bottom-8 right-6 grid h-[76px] w-[76px] rotate-[-14deg] place-items-center rounded-full border border-gold-deep text-center text-[.56rem] leading-tight text-gold-deep"><strong class="serif block text-xl">✦</strong>JOURNEY<br />READY</div></div><div class="absolute right-0 top-8 w-[185px] rotate-[-7deg] border border-line bg-white/80 p-[18px] shadow-xl max-md:right-[-6px] max-md:scale-[.84]"><div class="flex justify-between text-[.61rem] uppercase tracking-[.1em] text-gold-deep"><span>Journey ledger</span><span>01—13</span></div><div class="serif my-5 flex items-center gap-2 text-green"><span>JKT</span><i class="flex-1 border-t border-dashed border-gold"></i><span>JED</span></div><small class="text-[.65rem] text-muted">Persiapan yang baik memberi ruang lebih untuk beribadah.</small><div class="mt-4 grid h-14 w-14 rotate-[11deg] place-items-center rounded-full border border-gold text-center text-[.53rem] leading-tight text-gold-deep">READY<br />TO GO</div></div></div>
      </div></section>

      <section class="border-y border-line"><div class="mx-auto grid w-[min(1140px,calc(100%-40px))] grid-cols-3 max-md:w-[calc(100%-28px)] max-md:grid-cols-1"><div class="flex items-center gap-4 border-r border-line px-7 py-7 max-md:border-r-0 max-md:border-b max-md:px-0"><span class="grid h-10 w-10 place-items-center rounded-full bg-gold-soft font-serif text-gold-deep">01</span><span><strong class="block text-sm">13 bab berurutan</strong><small class="text-xs text-muted">Dari niat hingga pulang</small></span></div><div class="flex items-center gap-4 border-r border-line px-7 py-7 max-md:border-r-0 max-md:border-b max-md:px-0"><span class="grid h-10 w-10 place-items-center rounded-full bg-gold-soft font-serif text-gold-deep">✦</span><span><strong class="block text-sm">Praktis dan terarah</strong><small class="text-xs text-muted">Checklist, budget, dan itinerary</small></span></div><div class="flex items-center gap-4 px-7 py-7 max-md:px-0"><span class="grid h-10 w-10 place-items-center rounded-full bg-gold-soft font-serif text-gold-deep">↗</span><span><strong class="block text-sm">Langsung dibimbing</strong><small class="text-xs text-muted">Chat WhatsApp untuk mulai</small></span></div></div></section>

      <section class="px-0 py-28 max-md:py-[76px]"><div class="mx-auto grid w-[min(1140px,calc(100%-40px))] grid-cols-[.85fr_1.15fr] gap-[100px] max-[900px]:grid-cols-1 max-[900px]:gap-10 max-md:w-[calc(100%-28px)]"><div class="reveal"><span class="inline-flex items-center gap-2.5 text-[.72rem] font-bold uppercase tracking-[.16em] text-gold-deep before:h-px before:w-7 before:bg-current">Sebelum berangkat</span><h2 class="serif my-5 text-[clamp(2.35rem,5vw,4.5rem)] font-semibold leading-tight tracking-[-.055em]">Yang sering membuat jamaah ragu.</h2><p class="max-w-[390px] text-muted">Keinginan untuk umroh mandiri sering tertahan bukan karena tidak mampu, tetapi karena belum tahu urutan langkahnya.</p></div><div class="reveal grid grid-cols-2 gap-3.5 max-md:grid-cols-1"><article class="min-h-[150px] border border-line bg-white p-6 transition hover:-translate-y-1 hover:border-gold"><b class="serif mb-5 inline-block text-2xl text-gold">01</b><p class="m-0 text-sm text-muted">“Saya harus mulai dari mana? Dokumen, visa, atau tiket dulu?”</p></article><article class="min-h-[150px] border border-line bg-white p-6 transition hover:-translate-y-1 hover:border-gold"><b class="serif mb-5 inline-block text-2xl text-gold">02</b><p class="m-0 text-sm text-muted">Takut salah memilih penerbangan, hotel, dan transportasi di Tanah Suci.</p></article><article class="min-h-[150px] border border-line bg-white p-6 transition hover:-translate-y-1 hover:border-gold"><b class="serif mb-5 inline-block text-2xl text-gold">03</b><p class="m-0 text-sm text-muted">Ingin menghitung biaya dengan realistis, tanpa bergantung pada perkiraan.</p></article><article class="min-h-[150px] border border-line bg-white p-6 transition hover:-translate-y-1 hover:border-gold"><b class="serif mb-5 inline-block text-2xl text-gold">04</b><p class="m-0 text-sm text-muted">Khawatir lupa hal penting saat bepergian bersama keluarga.</p></article></div></div></section>

      <section class="bg-cream px-0 py-28 max-md:py-[76px]" id="isi"><div class="mx-auto w-[min(1140px,calc(100%-40px))] max-md:w-[calc(100%-28px)]"><div class="flex items-end justify-between gap-8 max-[900px]:block"><div class="reveal max-w-[720px]"><span class="inline-flex items-center gap-2.5 text-[.72rem] font-bold uppercase tracking-[.16em] text-gold-deep before:h-px before:w-7 before:bg-current">Isi ebook</span><h2 class="serif my-5 text-[clamp(2.35rem,5vw,4.5rem)] font-semibold leading-tight tracking-[-.055em]">Satu perjalanan.<br />Tiga belas bab.</h2><p class="max-w-[590px] text-[1.05rem] text-muted">Dirancang seperti teman perjalanan: hadir sebelum berangkat, membantu saat di Tanah Suci, hingga memastikan Anda pulang dengan tenang.</p></div><p class="reveal max-w-60 border-l border-gold pl-4 text-xs text-muted max-[900px]:mt-6">Urutan bab mengikuti alur nyata perjalanan umroh mandiri — bukan sekadar kumpulan teori.</p></div><div class="mt-14 border-t border-line reveal">{chapters.map(([number, title, description]) => <article class="grid min-h-[101px] grid-cols-[90px_.55fr_1fr] items-center gap-6 border-b border-line max-md:grid-cols-[52px_1fr] max-md:gap-2.5 max-md:py-5"><span class="serif text-3xl text-gold">{number}</span><h3 class="serif m-0 text-xl font-semibold max-md:text-lg">{title}</h3><p class="m-0 text-sm text-muted max-md:col-start-2">{description}</p></article>)}</div></div></section>

      <section class="px-0 py-28 max-md:py-[76px]" id="bonus"><div class="mx-auto w-[min(1140px,calc(100%-40px))] max-md:w-[calc(100%-28px)]"><div class="reveal max-w-[720px]"><span class="inline-flex items-center gap-2.5 text-[.72rem] font-bold uppercase tracking-[.16em] text-gold-deep before:h-px before:w-7 before:bg-current">Lebih dari sekadar ebook</span><h2 class="serif my-5 text-[clamp(2.35rem,5vw,4.5rem)] font-semibold leading-tight tracking-[-.055em]">Alat bantu yang membuat Anda bergerak.</h2><p class="max-w-[590px] text-[1.05rem] text-muted">Karena panduan yang baik bukan hanya dibaca — tetapi dipakai, dicentang, dan dibawa dalam perjalanan.</p></div><div class="mt-12 grid grid-cols-2 gap-5 reveal max-md:grid-cols-1"><article class="relative min-h-[265px] overflow-hidden border border-green bg-green p-9 text-white max-md:p-7"><span class="serif absolute right-7 top-5 text-[4.7rem] leading-none text-gold-soft/20">A</span><h3 class="serif relative z-10 max-w-[290px] text-2xl font-semibold">Checklist yang bisa langsung dipakai</h3><p class="relative z-10 max-w-[370px] text-sm text-white/70">Kurangi risiko lupa dengan daftar persiapan yang dibagi sesuai tahap perjalanan.</p><div class="relative z-10 mt-5 grid gap-2 text-xs"><span>✓ Dokumen & administrasi</span><span>✓ Barang bawaan</span><span>✓ Persiapan keluarga</span></div></article><article class="relative min-h-[265px] overflow-hidden border border-line bg-paper p-9 max-md:p-7"><span class="serif absolute right-7 top-5 text-[4.7rem] leading-none text-gold-soft">B</span><h3 class="serif relative z-10 max-w-[290px] text-2xl font-semibold">Rencanakan biaya dengan lebih jernih</h3><p class="relative z-10 max-w-[370px] text-sm text-muted">Gunakan template anggaran untuk melihat komponen biaya utama sebelum menentukan pilihan.</p><div class="relative z-10 mt-5 grid gap-2 text-xs"><span>✓ Template budget perjalanan</span><span>✓ Contoh itinerary</span><span>✓ Daftar aplikasi & website</span></div></article></div></div></section>

      <section class="bg-cream px-0 py-28 max-md:py-[76px]" id="paket"><div class="mx-auto w-[min(1140px,calc(100%-40px))] max-md:w-[calc(100%-28px)]"><div class="reveal mx-auto max-w-[720px] text-center"><span class="inline-flex items-center gap-2.5 text-[.72rem] font-bold uppercase tracking-[.16em] text-gold-deep before:h-px before:w-7 before:bg-current">Pilih paket Anda</span><h2 class="serif my-5 text-[clamp(2.35rem,5vw,4.5rem)] font-semibold leading-tight tracking-[-.055em]">Mulai sesuai kebutuhan.</h2><p class="text-muted">Keduanya membawa Anda ke langkah pertama. Paket Lengkap menambahkan alat bantu untuk merencanakan dengan lebih detail.</p></div><div class="mx-auto mt-12 grid max-w-[900px] grid-cols-2 gap-5 reveal max-md:grid-cols-1"><article class="border border-line bg-white p-10 max-md:p-7"><span class="text-[.7rem] font-bold uppercase tracking-[.16em] text-gold-deep">Paket Ebook</span><h3 class="serif mt-4 text-2xl font-semibold">Untuk mulai memahami</h3><div class="serif my-5 text-5xl tracking-[-.06em]">Rp49.000 <small class="font-sans text-xs tracking-normal text-muted">/ sekali bayar</small></div><ul class="mb-8 grid gap-3 p-0 text-sm text-muted"><li>✦ PDF ebook lengkap 13 bab</li><li>✦ Panduan kronologis dari nol sampai pulang</li></ul><a class="block w-full rounded-full border border-line px-5 py-3.5 text-center text-sm font-bold hover:border-gold" href={`${whatsapp}?text=Assalamu%E2%80%99alaikum%2C%20saya%20tertarik%20dengan%20Paket%20Ebook%20%E2%80%9CUmroh%20Mandiri%20dari%20Nol%E2%80%9D.%20Mohon%20info%20harga%20dan%20cara%20mendapatkannya.`} target="_blank" rel="noopener">Tanya Paket Ebook ↗</a></article><article class="relative -translate-y-3 border-[1.5px] border-gold bg-white p-10 shadow-editorial max-md:order-[-1] max-md:translate-y-0 max-md:p-7"><span class="absolute right-7 top-0 bg-gold px-3 py-2 text-[.62rem] font-bold tracking-[.12em] text-white">PALING LENGKAP</span><span class="text-[.7rem] font-bold uppercase tracking-[.16em] text-gold-deep">Paket Lengkap</span><h3 class="serif mt-4 text-2xl font-semibold">Untuk siap merencanakan</h3><div class="serif my-5 text-5xl tracking-[-.06em]">Rp99.000 <small class="font-sans text-xs tracking-normal text-muted">/ sekali bayar</small></div><ul class="mb-8 grid gap-3 p-0 text-sm text-muted"><li>✦ Semua isi ebook 13 bab</li><li>✦ Checklist dokumen & persiapan</li><li>✦ Template anggaran perjalanan</li><li>✦ Contoh itinerary</li><li>✦ Daftar aplikasi & website penting</li><li>✦ Update informasi jika tersedia</li></ul><a class="block w-full rounded-full bg-gold px-5 py-3.5 text-center text-sm font-bold text-white hover:bg-gold-deep" href={`${whatsapp}?text=Assalamu%E2%80%99alaikum%2C%20saya%20tertarik%20dengan%20Paket%20Lengkap%20%E2%80%9CUmroh%20Mandiri%20dari%20Nol%E2%80%9D%20beserta%20bonusnya.%20Mohon%20info%20harga%20dan%20cara%20mendapatkannya.`} target="_blank" rel="noopener">Ambil Paket Lengkap ↗</a></article></div></div></section>

      <section class="px-0 py-28 max-md:py-[76px]" id="penulis"><div class="mx-auto grid w-[min(1140px,calc(100%-40px))] grid-cols-[.78fr_1.22fr] items-center gap-[90px] max-[900px]:grid-cols-1 max-[900px]:gap-11 max-md:w-[calc(100%-28px)]"><div class="reveal grid min-h-[380px] place-items-center overflow-hidden bg-gold-soft"><div class="relative grid h-[180px] w-[142px] place-items-center rounded-[70px_70px_18px_18px] bg-green font-serif text-6xl text-gold-soft before:absolute before:top-[-42px] before:h-[82px] before:w-[82px] before:rounded-full before:bg-green">✦</div></div><div class="reveal"><span class="inline-flex items-center gap-2.5 text-[.72rem] font-bold uppercase tracking-[.16em] text-gold-deep before:h-px before:w-7 before:bg-current">Tentang penulis</span><h2 class="serif my-5 text-[clamp(2.35rem,5vw,4.5rem)] font-semibold leading-tight tracking-[-.055em]">Ditulis dari pengalaman, bukan sekadar teori.</h2><p class="text-muted">Penulis pernah menjalani proses umroh mandiri dan memahami bahwa setiap langkah kecil — memilih dokumen, menghitung budget, membaca peta, sampai menyiapkan hari kepulangan — ikut menentukan ketenangan perjalanan.</p><p class="text-muted">Ebook ini disusun untuk membantu jamaah pemula memiliki peta yang lebih jelas sebelum mengambil keputusan.</p><blockquote class="mt-7 border-l-2 border-gold pl-5 font-serif text-xl text-green">“Semoga perjalanan Anda dimulai dengan persiapan yang baik, lalu berlanjut menjadi ibadah yang lebih khusyuk.”</blockquote></div></div></section>

      <section class="bg-cream px-0 py-28 max-md:py-[76px]" id="faq"><div class="mx-auto w-[min(1140px,calc(100%-40px))] max-md:w-[calc(100%-28px)]"><div class="reveal max-w-[720px]"><span class="inline-flex items-center gap-2.5 text-[.72rem] font-bold uppercase tracking-[.16em] text-gold-deep before:h-px before:w-7 before:bg-current">Pertanyaan umum</span><h2 class="serif my-5 text-[clamp(2.35rem,5vw,4.5rem)] font-semibold leading-tight tracking-[-.055em]">Yang perlu Anda tahu sebelum mulai.</h2></div><div class="reveal mt-12 max-w-[780px] border-t border-line">{faqs.map(([question, answer], index) => <div class:list={['faq-item', { 'is-open': index === 0 }]}><button class="faq-question flex w-full justify-between gap-6 border-b border-line bg-transparent py-6 text-left font-serif text-xl max-md:text-base" aria-expanded={index === 0 ? 'true' : 'false'} aria-controls={`faq-answer-${index}`}><span>{question}</span><span class="faq-plus text-gold transition-transform">＋</span></button><div id={`faq-answer-${index}`} class="faq-answer max-w-[690px] border-b border-line text-sm text-muted">{answer}</div></div>)}</div></div></section>

      <section class="relative overflow-hidden bg-green px-0 py-28 text-white max-md:py-20"><div class="pointer-events-none absolute right-[-145px] top-[-160px] h-[440px] w-[440px] rounded-full border border-gold-soft/25 closing-ring"></div><div class="relative z-10 mx-auto max-w-[730px] w-[min(1140px,calc(100%-40px))] max-md:w-[calc(100%-28px)] reveal"><span class="inline-flex items-center gap-2.5 text-[.72rem] font-bold uppercase tracking-[.16em] text-gold-soft before:h-px before:w-7 before:bg-current">Langkah pertama dimulai di sini</span><h2 class="serif my-5 text-[clamp(2.35rem,5vw,4.5rem)] font-semibold leading-tight tracking-[-.055em]">Jadikan niat baik punya arah yang jelas.</h2><p class="max-w-[565px] text-white/70">Mulai pelajari prosesnya, siapkan yang perlu disiapkan, dan ambil keputusan dengan lebih tenang.</p><div class="mt-8 flex flex-wrap gap-3.5"><a class="rounded-full bg-gold px-6 py-4 text-sm font-bold text-white hover:bg-gold-deep" href={whatsappMessage} target="_blank" rel="noopener">Mulai chat di WhatsApp ↗</a><a class="rounded-full border border-white/35 px-6 py-4 text-sm font-bold hover:border-white" href="#paket">Lihat pilihan paket</a></div><p class="mt-9 max-w-[700px] border-t border-white/15 pt-4 text-xs text-white/50">Informasi dalam ebook disusun berdasarkan pengalaman dan sumber yang tersedia saat penulisan. Aturan visa, perjalanan, penerbangan, dan layanan dapat berubah. Selalu verifikasi informasi terbaru melalui sumber resmi sebelum mengambil keputusan.</p></div></section>
    </main>
    <footer class="bg-green-deep py-6 text-xs text-white/50"><div class="mx-auto flex w-[min(1140px,calc(100%-40px))] justify-between gap-5 max-md:w-[calc(100%-28px)] max-md:flex-col"><span class="serif text-white/85">Umroh Mandiri dari Nol</span><span>© {new Date().getFullYear()} · Panduan praktis untuk perjalanan yang lebih tenang.</span></div></footer>
    <script>
      const menuToggle = document.querySelector('#menu-toggle');
      const navLinks = document.querySelector('#nav-links');
      menuToggle?.addEventListener('click', () => { const open = navLinks?.classList.toggle('max-md:flex'); navLinks?.classList.toggle('max-md:hidden', !open); menuToggle?.setAttribute('aria-expanded', String(Boolean(open))); });
      navLinks?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { navLinks.classList.add('max-md:hidden'); navLinks.classList.remove('max-md:flex'); menuToggle?.setAttribute('aria-expanded', 'false'); }));
      document.querySelectorAll('.faq-question').forEach((button) => button.addEventListener('click', () => { const item = button.parentElement; const open = item?.classList.toggle('is-open'); button.setAttribute('aria-expanded', String(Boolean(open))); }));
      const reveals = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) { const observer = new IntersectionObserver((entries, obs) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); obs.unobserve(entry.target); } }), { threshold: .12 }); reveals.forEach((element) => observer.observe(element)); } else reveals.forEach((element) => element.classList.add('is-visible'));
    </script>
  </body>
</html>
